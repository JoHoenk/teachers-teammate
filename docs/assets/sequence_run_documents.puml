@startuml Teacher's Teammate — Run Selected
skinparam defaultFontSize 12
skinparam sequenceArrowThickness 1
skinparam sequenceLifeLineBorderColor #555555
skinparam shadowing false
skinparam noteBackgroundColor #FFFFDD

actor "Teacher" as USER
participant "RunStartController\n(GUI thread)" as START
participant "RunController\n(GUI thread)" as CTRL
participant "OCRWorker\n(QThread)" as WORKER
participant "RunService" as RUN
participant "run_files()" as COORD
participant "FileProcessor" as FP

USER -> START : Run Selected
START -> RUN : check_run_preflight()  [background task]
RUN --> START : RunPreflight
opt something is missing
  START -> USER : readiness line / dialog with the fix
end
opt memory warning, text leaves the computer, work of the teacher would be replaced
  START -> USER : one question each
  USER --> START : answer (Cancel starts nothing)
end
START -> CTRL : start(config, files)
CTRL -> WORKER : start()

== background thread ==

WORKER -> RUN : run_selected(config, files, progress)
note right of RUN : keeps the computer awake\nfor the whole run
RUN -> COORD : OCRPipeline.run()
loop for each file
  COORD -> FP : process(file)
  FP --> COORD : ProcessingResult
  COORD ---> WORKER : file_done(FileOutcome)
end
COORD --> RUN : RunSummary
RUN --> WORKER : RunSummary

== GUI thread (queued signals) ==

WORKER ---> CTRL : file_started · stage_started · ocr_done · file_done
CTRL -> CTRL : update the results table, reload the open document
WORKER ---> CTRL : run_finished(RunSummary)
CTRL -> USER : summary, Run enabled again

@enduml
