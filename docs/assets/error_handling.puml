@startuml Teacher's Teammate — Exceptions
skinparam defaultFontSize 12
skinparam classBorderColor #555555
skinparam classBackgroundColor #F4F4F4
skinparam arrowColor #444444
skinparam shadowing false
skinparam noteBackgroundColor #FFFFDD
skinparam noteBorderColor #AAAAAA
hide empty members

class Exception #DDDDDD
class ValueError #DDDDDD
class RuntimeError #DDDDDD
class FileNotFoundError #DDDDDD

package "teachers_teammate.exceptions" {
  class PipelineError
  class StageError
  class FileSkipped
  class OCRError
  class ModelMissingError
  class OCRTimeoutError
  class OCRDeadlineError
  class OllamaUnreachableError
  class ResponseTruncatedError
  class AnonymizerError
  class RunStoppedError
  class PipelineInputError
  class RecognitionSwitchedOffError
  class OnlineOcrNotAllowedError
  class ConfigFileNotFoundError
  class ConfigFileParseError
  class StorageResolutionError
  class ProviderNotAvailableError
  class ModelDownloadError
  class ModelDownloadCancelledError
  class AddonInstallError
  class AddonUpdateError
}

Exception <|-- PipelineError
PipelineError <|-- StageError
PipelineError <|-- FileSkipped
StageError <|-- OCRError
StageError <|-- AnonymizerError
OCRError <|-- ModelMissingError
OCRError <|-- OCRTimeoutError
OCRError <|-- OCRDeadlineError
OCRError <|-- OllamaUnreachableError
OCRError <|-- ResponseTruncatedError
Exception <|-- RunStoppedError
Exception <|-- ValueError
Exception <|-- RuntimeError
Exception <|-- FileNotFoundError
ValueError <|-- PipelineInputError
ValueError <|-- OnlineOcrNotAllowedError
ValueError <|-- ConfigFileParseError
PipelineInputError <|-- RecognitionSwitchedOffError
FileNotFoundError <|-- ConfigFileNotFoundError
RuntimeError <|-- StorageResolutionError
RuntimeError <|-- ProviderNotAvailableError
RuntimeError <|-- ModelDownloadError
RuntimeError <|-- AddonInstallError
RuntimeError <|-- AddonUpdateError
ModelDownloadError <|-- ModelDownloadCancelledError

note right of StageError
  Ends one file as **failed**; the next file runs.
  ""FileProcessor.process()"" has the one ""except"".
end note
note right of FileSkipped
  Ends one file as **skipped**: nothing failed.
end note
note right of RunStoppedError
  Fast exit of a stop; the stop event is the truth.
  Not an ""OCRError"" on purpose.
end note
@enduml
