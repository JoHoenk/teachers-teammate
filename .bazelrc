# Use remote JDKs so Java-dependent targets (for example docs tooling) do not
# require a system JAVA_HOME to be configured.
build --java_runtime_version=remotejdk_17
build --tool_java_runtime_version=remotejdk_17

# CI (`--config=ci`): a stale MODULE.bazel.lock fails the build instead of being
# updated silently, and the runner log stays readable.
common:ci --lockfile_mode=error --color=yes --curses=no
