@startuml Teacher's Teammate — Pipeline stages
top to bottom direction
skinparam defaultFontSize 11
skinparam shadowing false
skinparam arrowColor #555555

skinparam package {
  BackgroundColor #F5F5F5
  BorderColor #9E9E9E
  FontColor #1A237E
  FontStyle bold
  Padding 8
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #90A4AE
  FontSize 10
}
skinparam component<<local>> {
  BackgroundColor #E8F5E9
  BorderColor #388E3C
}
skinparam component<<choice>> {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}

package "1  InputProvider" as S_IN {
  component "PDF · JPG / PNG · TXT" as IN <<local>>
}

package "2  ImagePreprocessor  (scans only)" as S_PRE {
  component "Automatic · Original page" as PRE <<local>>
}

package "3  OCRProcessor  (scans only; skipped for TXT and for PDFs with a text layer)" as S_OCR {
  component "Ollama vision model\n(this computer or own network)" as OCR_OL <<local>>
  component "Built-in reader (PP-OCR)" as OCR_ALT <<local>>
}

package "3b  OcrOutputPostprocessor" as S_POST {
  component "One notation: plain text or Markdown" as POST <<local>>
}

package "4  Anonymizer  (optional)" as S_AN {
  component "spaCy names + patterns\n(e-mail · phone · IBAN · address · date)" as AN <<local>>
}

package "5  Corrector  (optional)" as S_CO {
  component "Ollama" as CO_OL <<choice>>
  component "Online service" as CO_CLD <<choice>>
}

package "6  Evaluator  (optional; needs 5)" as S_EV {
  component "Ollama" as EV_OL <<choice>>
  component "Online service" as EV_CLD <<choice>>
}

package "7  DocumentCreator" as S_OUT {
  component "Word (.docx) · text files\n(names put back)" as OUT <<local>>
}

S_IN  -down-> S_PRE
S_PRE -down-> S_OCR
S_OCR -down-> S_POST
S_POST -down-> S_AN
S_AN  -down-> S_CO
S_CO  -down-> S_EV
S_EV  -down-> S_OUT

legend right
  <back:#E8F5E9>green</back>  runs on this computer or in the own network
  <back:#E3F2FD>blue</back>  the teacher chooses: Ollama, or an online service
         (confirmed before a run; names hidden when stage 4 is on)
endlegend
@enduml
