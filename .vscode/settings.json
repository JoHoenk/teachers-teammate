{
    "files.exclude": {
        "**/bazel-*": true,
        "**/.build_venv": true,
        "**/.venv*": true,
        "**/build": true,
        "**/dist": true,
        "**/pyinstaller-work": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.mypy_cache": true,
        "**/*.egg-info": true,
        "**/coverage_html": true,
        "teachers_teammate/_models": true,
        "teachers_teammate/_build": true
    },
    "search.exclude": {
        "**/bazel-*": true,
        "**/.build_venv": true,
        "**/.venv*": true,
        "**/build": true,
        "**/dist": true,
        "**/pyinstaller-work": true,
        "**/*.egg-info": true,
        "**/coverage_html": true,
        "teachers_teammate/_models": true,
        "teachers_teammate/_build": true,
        "input": true,
        "output*": true,
        "previews": true,
        "pdfs": true
    },
    "files.watcherExclude": {
        "**/bazel-*/**": true,
        "**/.build_venv/**": true,
        "**/.venv*/**": true,
        "**/build/**": true,
        "**/dist/**": true,
        "**/pyinstaller-work/**": true,
        "**/.git/objects/**": true,
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.mypy_cache/**": true,
        "**/coverage_html/**": true,
        "teachers_teammate/_models/**": true,
        "teachers_teammate/_build/**": true,
        "input/**": true,
        "output*/**": true,
        "previews/**": true,
        "pdfs/**": true
    },
    "python.analysis.exclude": [
        "**/bazel-*",
        "**/.build_venv",
        "**/.venv*",
        "**/build",
        "**/dist",
        "**/pyinstaller-work",
        "teachers_teammate/_models",
        "teachers_teammate/_build"
    ],
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": false
}
