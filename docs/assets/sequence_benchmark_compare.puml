@startuml Teacher's Teammate — Benchmark: run, store, compare
skinparam defaultFontSize 12
skinparam sequenceArrowThickness 1
skinparam sequenceLifeLineBorderColor #555555
skinparam shadowing false

actor "Teacher" as USER
participant "BenchmarkWindow" as WIN
participant "BenchmarkWorker\n(QThread)" as WORKER
participant "BenchmarkApplication\nService" as SVC
participant "run_ocr()" as RUN
participant "BenchmarkRunStore" as STORE
participant "compare_pair()\n(domain)" as DOM

== Run and store one setup ==
USER -> WIN : choose document, Run & store
WIN -> WORKER : start()
WORKER -> SVC : run_and_store(source, ocr, language)
SVC -> RUN : run_ocr(config, source)
note right of RUN : prepare the pages and read them;\nno proofreading, no Word file
RUN --> SVC : OcrRunResult
SVC -> STORE : save(NewRunRequest)
note right of STORE : append-only; keeps the newest N runs\nper document
STORE --> SVC : StoredRun
WORKER ---> WIN : finished_ok(StoredRun)
WIN -> SVC : list_runs(source)
SVC --> WIN : runs, newest first

== Compare two stored runs ==
USER -> WIN : Set as A, Set as B
WIN -> SVC : compare(run_a, run_b)
SVC -> DOM : compare_pair(text_a, text_b)
DOM --> SVC : PairComparison
SVC --> WIN : PairComparison
WIN -> USER : page, both texts, differences, similarity
@enduml
