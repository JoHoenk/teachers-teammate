)

# Sphinx docs rules. A separate module since rules_python 2.0; keep it on the
# same version as rules_python.
bazel_dep(
    name = "sphinxdocs",
    version = "2.5.1",
    dev_dependency = True,
)

# OS constraint for the one lint test that only runs on Linux (//:ps_script_analyzer).
bazel_dep(
    name = "platforms",
    version = "1.0.0",
    dev_dependency = True,
)

# sh_library for the shell scripts, so the shellcheck aspect of rules_lint has targets to visit.
# rules_lint depends on the same version.
bazel_dep(
    name = "rules_shell",
    version = "0.5.0",
    dev_dependency = True,
)

bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "rules_java", version = "9.9.0")

# One Python version for the whole repository: `.python-version` holds the full patch, and
# rules_python reads it here.  CI's setup-python reads the same file, so the Bazel tests and the
# bundles cannot drift apart.  Bumped by hand (a weekly job that reports a newer patch is still
# to be written: plans/ci-build-fixes.md, C6).  `python.defaults` alone would register the
# toolchain without the coverage tool, so the same patch is named again below for
# `bazel coverage`: change both together.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version_file = "//:.python-version")
python.toolchain(
    configure_coverage_tool = True,
    python_version = "3.14.10",
)

# Dev-only pip hub: tools required for linting (pylint and deps).
pip_dev = use_extension(
    "@rules_python//python/extensions:pip.bzl",
    "pip",
    dev_dependency = True,
)
pip_dev.parse(
    hub_name = "ocr_dev_dependencies",
    python_version = "3.14",
    requirements_lock = "//:requirements_dev_lock.txt",
)
use_repo(pip_dev, "ocr_dev_dependencies")

# Test pip hub: runtime subset + pytest, used by //tests:unit_tests.
pip_test = use_extension(
    "@rules_python//python/extensions:pip.bzl",
    "pip",
    dev_dependency = True,
)
pip_test.parse(
    hub_name = "ocr_test_dependencies",
    python_version = "3.14",
    requirements_lock = "//:requirements_test_lock.txt",
)
use_repo(pip_test, "ocr_test_dependencies")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "blueprint_maven_dependencies",
    artifacts = [
        "net.sourceforge.plantuml:plantuml:1.2025.9",
    ],
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "blueprint_maven_dependencies")

bazel_dep(name = "trlc", version = "0.0.0")
git_override(
    module_name = "trlc",
    commit = "08ff8c7d6c362153392003c671a9799a446b0db5",
    # trlc locks its pip packages (cvc5, pyvcg, sphinx) for Python 3.9 - 3.12 only, while the
    # repository is on 3.14: the patch runs its `trlc_rst` tool on 3.12 and lets its Sphinx
    # extension use the Sphinx of `//docs:sphinx-build`.  Drop it once trlc locks 3.14.
    patch_strip = 1,
    patches = ["//third_party/trlc:python.patch"],
    remote = "https://github.com/bmw-software-engineering/trlc.git",
)

# The built-in reader's pinned model files (domain/local_models.py), fetched once for the tests
# that run the real models. Keep revision and hashes in step with the catalogue; the test
# tests/unit/test_local_models.py and the integration test fail first if they drift.
http_file = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_file",
)

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

# PowerShell and the two modules aspect_rules_lint's PSScriptAnalyzer aspect needs (it ships none
# of them): //:ps_script_analyzer lints the .ps1 installer scripts. Linux x86_64 only, which is
# where the lint runs (CI and the WSL development machine); the test is marked incompatible
# elsewhere. The hashes are the publishers' own: hashes.sha256 of the PowerShell release, and the
# nupkg of each module on the PowerShell Gallery. A bump is a manual change (no Dependabot
# ecosystem reads these URLs).
http_archive(
    name = "pwsh",
    build_file_content = """exports_files(["pwsh"])""",
    sha256 = "e261cabc91c78a9afe8d1e5f24731ab0d38204735ab2ec94b0af55102652e10d",
    urls = ["https://github.com/PowerShell/PowerShell/releases/download/v7.6.10/powershell-7.6.10-linux-x64.tar.gz"],
)

http_archive(
    name = "psscriptanalyzer",
    build_file_content = """filegroup(name = "files", srcs = glob(["**"]), visibility = ["//visibility:public"])""",
    sha256 = "14e634c828eb98efb9f40b2918ba90f139ed5eccdf663a2a747736d996995d60",
    type = "zip",
    urls = ["https://www.powershellgallery.com/api/v2/package/PSScriptAnalyzer/1.25.0"],
)

http_archive(
    name = "converttosarif",
    build_file_content = """filegroup(name = "files", srcs = glob(["**"]), visibility = ["//visibility:public"])""",
    sha256 = "b1bdf60f029f12284dd78b2c2edc34705d4475079b4cb3d50d669da464bf3d35",
    type = "zip",
    urls = ["https://www.powershellgallery.com/api/v2/package/ConvertToSARIF/1.0.0"],
)

