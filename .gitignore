# Python
*.so
__pycache__/
*.egg-info/
dist/
/build/
.coverage
# Claude Code: keep local state out, but allow shared .claude/settings.json, skills and rules
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/rules/
coverage_html/

# Virtual environments
.venv/
.build_venv/

# The third-party license texts are committed (tools/licenses/inventory.py --compile):
# third_party_licenses/ and the compiled list it writes.

# PyInstaller build scratch
pyinstaller-work/
# Written by tools/build/addon_constraints.py, bundled as data
teachers_teammate/_build/
# Fetched by tools/build/fetch_models.py (the reader and the page models), bundled as data
teachers_teammate/_models/

# IDE (the shared .vscode/settings.json is tracked; see CONTRIBUTING.md)
.vscode/*
!.vscode/settings.json
.idea/

# Type checking
.mypy_cache/
.ruff_cache

# Bazel
bazel-*

# Generated docs (Bazel outputs)
docs/test_specs.rst

# The app's working folders, at the repository root only: a leading slash keeps the rule from
# swallowing a source package such as tools/evaluation/input/.
/input/
/output*/
/previews/
/pdfs/

# Working notes and research plans (not part of the source tree)
plans/
